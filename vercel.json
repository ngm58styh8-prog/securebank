{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/auth/callback.html", "destination": "/auth/callback", "permanent": true }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/investment-credits",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/investment-emails",
      "schedule": "*/5 * * * *"
    }
  ]
}

{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/investment-credits",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/investment-emails",
      "schedule": "*/5 * * * *"
    }
  ]
}

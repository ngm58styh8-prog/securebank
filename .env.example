# Vercel / local development (vercel dev)
# Never commit real values — set these in Vercel Project Settings → Environment Variables

SUPABASE_URL=https://your-project.supabase.co

# New Supabase secret API key (recommended — sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_your_secret_key

# Or JSON map from Supabase Edge Functions / dashboard integration:
# SUPABASE_SECRET_KEYS={"default":"sb_secret_your_secret_key"}

# Legacy JWT service_role key (still supported):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=GlobalVest <onboarding@yourdomain.com>

# Vercel / local development (vercel dev)
# Never commit real values — set these in Vercel Project Settings → Environment Variables

# Use local JSON files (data/accounts.json) when Supabase is not configured
USE_LOCAL_REGISTRY=1

# Vercel Cron → /api/cron/investment-credits (market + Gold earnings batch)
CRON_SECRET=generate_a_long_random_secret

SUPABASE_URL=https://your-project.supabase.co

# Database password (Supabase → Project Settings → Database) — for npm run supabase:push only
SUPABASE_DB_PASSWORD=your_database_password

# MUST be the service_role JWT (eyJ...) or sb_secret_ key — NOT the anon/publishable key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Public anon/publishable key for Google & Apple OAuth (browser-safe)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Enable Google + Apple in Supabase → Authentication → Providers
# Redirect URL: https://globalvestbank.com/auth/callback.html

RESEND_API_KEY=re_your_resend_api_key
# Verified domain in Resend — never use onboarding@resend.dev in production
RESEND_FROM_EMAIL=GlobalVest Bank <noreply@globalvestbank.com>
RESEND_REPLY_TO=support@globalvestbank.com
RESEND_SITE_URL=https://globalvestbank.com
# Optional CAN-SPAM physical footer line
RESEND_PHYSICAL_ADDRESS=GlobalVest Bank, 120 Broadway, New York, NY 10271, United States

# DNS (at your domain registrar — copy exact values from Resend Domains → Records):
# SPF TXT on globalvestbank.com
# DKIM CNAME/TXT on resend._domainkey.globalvestbank.com
# DMARC TXT on _dmarc.globalvestbank.com → v=DMARC1; p=none; rua=mailto:dmarc@globalvestbank.com; fo=1

# --- Investment confirmation emails ---
# Sender for investment confirmations. Must be on the domain verified in Resend (globalvestbank.com).
# Defaults to GlobalVest Investments <investments@globalvestbank.com>.
INVESTMENT_EMAIL_FROM=GlobalVest Investments <investments@globalvestbank.com>
# Signing secret from Resend → Webhooks (whsec_...). Webhook URL: https://globalvestbank.com/api/resend-webhook
# Subscribe to: email.sent, email.delivered, email.delivery_delayed, email.bounced, email.complained, email.failed
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret
# Comma-separated inboxes alerted when a confirmation email fails after all retries
INVESTMENT_EMAIL_ADMIN_ALERT_TO=ops@globalvestbank.com
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/* (retry queue + investment credits)
CRON_SECRET=generate_a_long_random_string

# Vercel / local development (vercel dev)
# Never commit real values — set these in Vercel Project Settings → Environment Variables

SUPABASE_URL=https://your-project.supabase.co

# MUST be the service_role JWT (eyJ...) or sb_secret_ key — NOT the anon/publishable key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=GlobalVest <onboarding@yourdomain.com>
